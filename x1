#!/bin/bash

# Exit immediately if a command exits with a non-zero status
set -e

# 1. Get project name from the current directory if not provided
REPO_NAME=${1:-$(basename "$PWD")}

echo "🚀 Preparing to push project: $REPO_NAME"

# 2. Initialize Git if not already initialized
if [ ! -d ".git" ]; then
    echo "📂 Initializing local Git repository..."
    git init
    git branch -M main
fi

# 3. Add all files and commit
echo "📦 Staging and committing files..."
git add .

# Check if there's anything to commit
if git diff-index --quiet HEAD -- 2>/dev/null; then
    echo "⚠️ No changes to commit."
else
    git commit -m "Initial commit: whole project upload"
fi

# 4. Create repository on GitHub automatically using GitHub CLI
# Checks if 'origin' remote already exists
if git remote get-url origin >/dev/null 2>&1; then
    echo "🔗 Remote 'origin' already exists."
else
    echo "🌐 Creating new public GitHub repository: $REPO_NAME..."
    # Change '--public' to '--private' if you prefer private repositories by default
    gh repo create "$REPO_NAME" --public --source=. --remote=origin --push
    echo "🎉 Successfully created and pushed to GitHub!"
    exit 0
fi

# 5. Push if remote already exists
echo "🚀 Pushing to GitHub..."
git push -u origin main

echo "🎉 Done! Project successfully pushed."
